### Get Holding details (using environment variable)
GET {{host}}/holdings/{{cph}}
Accept: application/json
x-cdp-request-id: {{$guid}}

> ../Asserts/Should_be_200_OK.js

### Get Holding details (Oakfield Farm fixture in lis-fake-service)
GET {{host}}/holdings/22/001/0001
Accept: application/json

> ../Asserts/Should_be_200_OK.js

### Get Cattle for Holding (using environment variable)
GET {{host}}/holdings/{{cph}}/cattle
Accept: application/json

> ../Asserts/Should_be_200_OK.js

### Get Cattle for Holding (explicit CPH)
GET {{host}}/holdings/12/345/6789/cattle
Accept: application/json

> ../Asserts/Should_be_200_OK.js

### Search Cattle on Holding (ear tag, breed code or name, sex)
GET {{host}}/holdings/22/001/0001/cattle?earTag=UK2000&breed=AA&sex=female
Accept: application/json

> ../Asserts/Should_be_200_OK.js

### Get Cattle details (Oakfield animal fixture in lis-fake-service)
GET {{host}}/cattle/UK200000000001
Accept: application/json
x-cdp-request-id: {{$guid}}

> ../Asserts/Should_be_200_OK.js

### Get Cattle details (unknown ear tag)
GET {{host}}/cattle/UK999999999999
Accept: application/json

> ../Asserts/Should_be_404.js

### Get Bundles for Holding (using environment variable)
GET {{host}}/holdings/{{cph}}/bundles
Accept: application/json

> ../Asserts/Should_be_200_OK.js

### Get Bundles for Holding (explicit CPH)
GET {{host}}/holdings/12/345/6789/bundles
Accept: application/json

> ../Asserts/Should_be_200_OK.js

