### Create or refresh a user account (lis-fake-service keeps accounts in memory, so run this before the GETs)
POST {{host}}/v1/users
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Content-Type: application/json
Accept: application/json

{
  "sub": "{{subject}}",
  "email": "contact@test.com",
  "given_name": "FirstName",
  "family_name": "LastName"
}

> ../Asserts/Should_be_200_OK.js

### Create a user account (missing email)
POST {{host}}/v1/users
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Content-Type: application/json
Accept: application/json

{
  "sub": "{{subject}}",
  "given_name": "FirstName",
  "family_name": "LastName"
}

> ../Asserts/Should_be_400_bad_request.js

### Create a user account (email already bound to another subject)
POST {{host}}/v1/users
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Content-Type: application/json
Accept: application/json

{
  "sub": "{{$uuid}}",
  "email": "contact@test.com",
  "given_name": "FirstName",
  "family_name": "LastName"
}

> ../Asserts/Should_be_409_conflict.js

### Get User details
GET {{host}}/v1/users/{{subject}}
x-api-key: {{apiKey}}
Accept: application/json
x-cdp-request-id: {{$guid}}

> ../Asserts/Should_be_200_OK.js

### Get User details (unknown subject)
GET {{host}}/v1/users/00000000-0000-4000-8000-000000000000
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../Asserts/Should_be_404.js

### Get User details (subject rejected by KRDS)
GET {{host}}/v1/users/not-a-uuid
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../Asserts/Should_be_400_bad_request.js
