<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AddOpenApi in the OpenAPI document tests is intercepted by the OpenAPI XML comment generator. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Liquibase schema, applied to the Testcontainers Postgres by the integration tests. -->
    <None Include="..\..\changelog\schema\**\*.sql" LinkBase="changelog\schema" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
    <ProjectReference Include="..\..\src\Database\Database.csproj" />
    <ProjectReference Include="..\..\src\Entities\Entities.csproj" />
  </ItemGroup>

</Project>
