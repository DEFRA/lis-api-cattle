{
  "PostgresConfiguration": {
    "UseIamAuthentication": false
  },
  "ConnectionStrings": {
    "ReadWritePostgresConnection": "User ID=lis_api_cattle_ddl;Password=postgres;Host=localhost;Port=5432;Database=lis_api_cattle;",
    "ReadOnlyPostgresConnection": "User ID=lis_api_cattle_ddl;Password=postgres;Host=localhost;Port=5432;Database=lis_api_cattle;"
  },
  "AWS": {
    "UseLocalStack": true,
    "ServiceUrl": "http://localhost:4566",
    "SubmissionValidationQueueUrl": "http://localhost:4566/000000000000/submission_validation_queue",
    "SubmissionValidationTopicArn": "arn:aws:sns:eu-west-2:000000000000:submission_validation_topic",
    "RegistrationBundleQueueUrl": "http://localhost:4566/000000000000/lis_cattle_registration_bundle"
  },
  "CadsDataPatch": {
    "BucketName": "cads-data-patch"
  },
  "CadsApi": {
    "BaseUrl": "http://localhost:3000/cads/",
    "ClientId": "local-dev-cads-client",
    "ClientSecret": "local-dev-cads-secret"
  },
  "CtsWeb": {
    "Url": "http://localhost:3000/cts_ws/DefraDataTransferPublicNWSE.asmx",
    "ServiceName": "DEFRA-CTWS-FULL-PROVING",
    "DthUsername": "local-dev-dth-username",
    "DthPassword": "local-dev-dth-password",
    "CtsOnlineUsername": "dev-cts-usr",
    "CtsOnlinePassword": "dev-cts-pass123"
  },
  "KrdsApi": {
    "BaseUrl": "http://localhost:3000/krds/",
    "ClientId": "local-dev-krds-client",
    "ClientSecret": "local-dev-krds-secret"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({SourceContext}) [{CorrelationId}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
