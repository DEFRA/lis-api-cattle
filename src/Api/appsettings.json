{
  "PostgresConfiguration": {
    "UseIamAuthentication": true,
    "ReadWriteHost": "set in cdp settings",
    "ReadOnlyHost": "set in cdp settings",
    "Port": 5432,
    "Name": "set in cdp settings",
    "User": "set in cdp settings"
  },
  "AWS": {
    "Region": "eu-west-2",
    "UseLocalStack": false,
    "EnableBackgroundConsumer": true,
    "PollingIntervalSeconds": 10,
    "EnableRegistrationBundleConsumer": true,
    "RegistrationBundleVisibilityTimeoutSeconds": 300,
    "RegistrationBundleMaxReceiveCount": 5
  },
  "SubmissionValidation": {
    "MinDamAgeInMonths": 15,
    "MaxDamAgeInYears": 20,
    "MinCalvingIntervalDays": 240,
    "MaxApplicationLateDays": 27
  },
  "CtsPollingJob": {
    "Enabled": true,
    "CronSchedule": "0/30 * * * * ?",
    "PollingIntervalSeconds": 30,
    "BatchSize": 10
  },
  "CtsApi": {
    "UseFake": true
  },
  "CtsWeb": {
    "Url": "http://lis-fake-service/cts_ws/DefraDataTransferPublicNWSE.asmx",
    "ServiceName": "",
    "DthUsername": "",
    "DthPassword": "",
    "CtsOnlineUsername": "",
    "CtsOnlinePassword": "",
    "TimeoutMilliseconds": 30000,
    "MaxAttempts": 3,
    "RetryDelayMilliseconds": 1000
  },
  "CadsDataPatch": {
    "BucketName": ""
  },
  "CadsApi": {
    "BaseUrl": "http://lis-fake-service/cads/",
    "ClientId": "",
    "ClientSecret": "",
    "PageSize": 500,
    "GetAnimalsOnHoldingTimeout": 60000,
    "GetAnimalDetailsTimeout": 60000,
    "CircuitBreakerConsecutiveFailureThreshold": 5,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDuration": 30000,
    "CircuitBreakerDurationOfBreak": 30000,
    "CircuitBreakerMinimumThroughput": 10
  },
  "ApiKeyAuthentication": {
    "Keys": []
  },
  "KrdsApi": {
    "BaseUrl": "http://lis-fake-service/krds/",
    "ClientId": "",
    "ClientSecret": "",
    "GetHoldingDetailsTimeout": 60000,
    "SearchHoldingsTimeout": 60000,
    "GetUserAccountTimeout": 60000,
    "EnsureUserAccountTimeout": 60000,
    "CircuitBreakerConsecutiveFailureThreshold": 5,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDuration": 30000,
    "CircuitBreakerDurationOfBreak": 30000,
    "CircuitBreakerMinimumThroughput": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
