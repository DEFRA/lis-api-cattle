<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
    <!-- AV0029: the internal OpenAPI documents are deliberately plain AddOpenApi documents (see OpenApiConfiguration); the
         warning is also raised in the generated XML comment interceptor, which a #pragma cannot reach. -->
    <NoWarn>$(NoWarn);AV0029</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Database\Database.csproj" />
  </ItemGroup>
  <Target Name="CollectOpenApiDocuments" AfterTargets="GenerateOpenApiDocuments"
          Condition="'$(OpenApiGenerateDocuments)' == 'true'">
    <PropertyGroup>
      <OpenApiArtifactsDirectory>$(MSBuildProjectDirectory)/../../artifacts/openapi</OpenApiArtifactsDirectory>
    </PropertyGroup>
    <!-- The generator writes the default document (v1) as Api.json and every other document as Api_{name}.json. -->
    <ItemGroup>
      <NamedOpenApiDocument Include="$(OpenApiDocumentsDirectory)/$(MSBuildProjectName)_*.json" />
    </ItemGroup>
    <!-- The upload ignores an empty folder because the shared workflow also serves services with no OpenAPI, so fail here. -->
    <Error Condition="'@(NamedOpenApiDocument)' == '' And !Exists('$(OpenApiDocumentsDirectory)/$(MSBuildProjectName).json')"
           Text="No OpenAPI documents were generated in $(OpenApiDocumentsDirectory)." />
    <!-- Start clean so a retired version is never published from an earlier build. -->
    <RemoveDir Directories="$(OpenApiArtifactsDirectory)" />
    <Copy Condition="Exists('$(OpenApiDocumentsDirectory)/$(MSBuildProjectName).json')"
          SourceFiles="$(OpenApiDocumentsDirectory)/$(MSBuildProjectName).json"
          DestinationFiles="$(OpenApiArtifactsDirectory)/v1.json" />
    <Copy SourceFiles="@(NamedOpenApiDocument)"
          DestinationFiles="@(NamedOpenApiDocument->'$(OpenApiArtifactsDirectory)/$([System.String]::Copy('%(Filename)').Substring($([MSBuild]::Add($(MSBuildProjectName.Length), 1)))).json')" />
  </Target>
</Project>
